# 防止直接访问 init.php
<Files "init.php">
    Order Allow,Deny
    Deny from all
</Files>

# 或者只允许特定IP访问（生产环境建议）
# <Files "init.php">
#     Order Deny,Allow
#     Deny from all
#     Allow from 192.168.1.100
# </Files>

# 保护配置文件
<Files "database.php">
    Order Allow,Deny
    Deny from all
</Files>

# 保护上传目录
<Directory "uploads">
    Order Allow,Deny
    Deny from all
</Directory>

# URL重写规则
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?path=$1 [L,QSA]